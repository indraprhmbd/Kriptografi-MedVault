# MedVault Go environment.
#
# Copy to /home/medvault/.env and replace every CHANGE_ME value.
# Generate 32 byte secrets with: openssl rand -hex 32

# Network. Inside the pod the app must listen on all interfaces.
MEDVAULT_APP_ADDR=0.0.0.0:8095
MEDVAULT_VALIDATOR_ADDR=0.0.0.0:8096
MEDVAULT_VALIDATOR_URL=http://127.0.0.1:8096

# Container paths, mounted from /home/medvault/storage.
MEDVAULT_DB_PATH=/data/medvault.db
MEDVAULT_VAULT_DIR=/data/encrypted_labs
MEDVAULT_STEGO_DIR=/data/stego_scans
MEDVAULT_BIOMETRIC_DIR=/data/biometrics

# Master key material, 32 bytes hex each.
MEDVAULT_MASTER_AES256_KEY_HEX=CHANGE_ME_64_HEX_CHARS
MEDVAULT_MASTER_ROOT_SECRET_HEX=CHANGE_ME_64_HEX_CHARS
MEDVAULT_STEGO_HMAC_KEY_HEX=CHANGE_ME_64_HEX_CHARS
MEDVAULT_SESSION_SECRET_HEX=CHANGE_ME_64_HEX_CHARS

# Classical cipher defaults. Change them for a real deployment.
MEDVAULT_VIGENERE_KEY=MEDVAULT-CLASSICAL-KEY-2026
MEDVAULT_TRANSPOSITION_KEY=KLINIK

# Validator gateway Ed25519 key pair. Generate with medvault-validator-keygen.
MEDVAULT_VALIDATOR_PRIVKEY_HEX=
MEDVAULT_VALIDATOR_PUBKEY_HEX=

# Biometric threshold out of 64 bits.
MEDVAULT_DHASH_MAX_DISTANCE=14

# WebAuthn relying party. RPID is the bare host, origins include the scheme.
MEDVAULT_WEBAUTHN_RP_DISPLAY_NAME=MedVault Go
MEDVAULT_WEBAUTHN_RPID=CHANGE_ME.example.com
MEDVAULT_WEBAUTHN_ORIGINS=https://CHANGE_ME.example.com

# Session lifetime in minutes.
MEDVAULT_SESSION_TTL_MINUTES=480

# Leave empty in production. Set to ./web only for live frontend editing.
MEDVAULT_DEV_WEB_DIR=